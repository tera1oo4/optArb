# --- Venues to run (comma-separated): deribit, bybit, okx, binance, polymarket ---
VENUES=deribit

# --- Deribit connector (defaults point at TESTNET — safe) ---
DERIBIT_WS_URL=wss://test.deribit.com/ws/api/v2
DERIBIT_REST_URL=https://test.deribit.com/api/v2
DERIBIT_CURRENCY=BTC
DERIBIT_MAX_INSTRUMENTS=40
DERIBIT_BOOK_DEPTH=10

# --- Bybit connector (defaults point at TESTNET — safe) ---
BYBIT_WS_URL=wss://stream-testnet.bybit.com/v5/public/option
BYBIT_REST_URL=https://api-testnet.bybit.com
BYBIT_BASE_COIN=BTC
BYBIT_MAX_INSTRUMENTS=40
BYBIT_BOOK_DEPTH=25

# --- OKX connector (defaults point at DEMO environment — safe) ---
OKX_WS_URL=wss://wspap.okx.com:8443/ws/v5/public
OKX_REST_URL=https://www.okx.com
OKX_DEMO_TRADING=true
OKX_ULY=BTC-USD
OKX_MAX_INSTRUMENTS=40

# --- Binance connector (no options testnet exists; PUBLIC READ-ONLY streams only) ---
BINANCE_MARKET_WS_URL=wss://fstream.binance.com/market/stream
BINANCE_PUBLIC_WS_URL=wss://fstream.binance.com/public/stream
BINANCE_REST_URL=https://eapi.binance.com
BINANCE_UNDERLYINGS=BTC
BINANCE_MAX_INSTRUMENTS=40
BINANCE_BOOK_DEPTH=10

# --- Polymarket connector (NO testnet exists; PUBLIC MAINNET READ-ONLY only) ---
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_UNDERLYINGS=BTC
POLYMARKET_MAX_MARKETS=20
POLYMARKET_BOOK_DEPTH=10

# --- Cross-venue detector (apps/trader, paper mode; apps/backtest) ---
SIGNAL_MIN_SPREAD_BPS=25
SIGNAL_MAX_QUOTE_AGE_MS=2000
SIGNAL_MIN_SIZE_USD=1000
SCAN_INTERVAL_MS=250

# --- Backtest engine (apps/backtest) ---
# SCAN_INTERVAL_MS=1000
# PAPER_REPORT_INTERVAL_MS=60000

# --- Paper execution / portfolio (ADR-0006; NEVER sends real orders) ---
PAPER_MAX_NOTIONAL_USD=10000
PAPER_REPORT_INTERVAL_MS=60000
PAPER_FILL_SLIPPAGE_BPS=0
PAPER_SIGNAL_HORIZONS_MS=60000,300000

# --- OMS two-legged state machine (M9; still paper-only, no real orders) ---
OMS_ENABLED=false
OMS_LEG_TIMEOUT_MS=5000
OMS_MAX_ATTEMPTS=3
# Optional fee overrides (fractions, e.g. 0.0003). Leave unset to use defaults.
# PAPER_FEE_DERIBIT_TAKER_RATE=0.0003
# PAPER_FEE_DERIBIT_CAP_FRACTION=0.125
# PAPER_FEE_BYBIT_TAKER_RATE=0.0003
# PAPER_FEE_BYBIT_CAP_FRACTION=0.125
# PAPER_FEE_OKX_TAKER_RATE=0.0003
# PAPER_FEE_OKX_CAP_FRACTION=0.125
# PAPER_FEE_BINANCE_TAKER_RATE=0.0003
# PAPER_FEE_BINANCE_CAP_FRACTION=0.10
# PAPER_FEE_POLYMARKET_TAKER_RATE=0.07

# --- Storage (ADR-0005) ---
CAPTURE_DIR=./data/capture

# --- Postgres audit persistence (optional; SSOT for fills/positions/risk decisions) ---
# Leave unset to run the trader without Postgres. To start local infra:
#   docker compose up -d
#   pnpm --filter @optarb/persistence migrate
POSTGRES_USER=optarb
POSTGRES_PASSWORD=optarb
POSTGRES_DB=optarb
PERSIST_POSTGRES_URL=postgresql://optarb:optarb@localhost:5432/optarb
# Optional analytics Postgres URL (defaults to PERSIST_POSTGRES_URL)
# ANALYTICS_POSTGRES_URL=postgresql://optarb:optarb@localhost:5432/optarb

# --- Backtest analytics (M10) ---
BACKTEST_ANALYTICS=false

# --- Redis hot state (ADR-0005) ---
# Redis is required by ADR-0005 for hot state even if not used in code yet.
# Started automatically by docker-compose.yml above.
REDIS_URL=redis://localhost:6379/0
# Optional override for the global kill-switch key (default: optarb:kill:switch).
# RISK_KILL_SWITCH_REDIS_KEY=optarb:kill:switch
# Static fallback kill switch when Redis is not configured (default: false).
# RISK_KILL_SWITCH=false
# Integration tests only: point at a disposable Redis instance.
# TEST_REDIS_URL=redis://localhost:6379/1

# --- Logging ---
LOG_LEVEL=info
STATS_INTERVAL_MS=10000

# --- LIVE TRADING: must stay false unless explicitly enabled by the operator (ADR-0006) ---
LIVE_TRADING=false
