# --- Deribit connector (defaults point at TESTNET — safe) ---
DERIBIT_WS_URL=wss://test.deribit.com/ws/api/v2
DERIBIT_REST_URL=https://test.deribit.com/api/v2
DERIBIT_CURRENCY=BTC
DERIBIT_MAX_INSTRUMENTS=40
DERIBIT_BOOK_DEPTH=10

# --- Storage (ADR-0005) ---
CAPTURE_DIR=./data/capture

# --- Logging ---
LOG_LEVEL=info
STATS_INTERVAL_MS=10000

# --- LIVE TRADING: must stay false unless explicitly enabled by the operator (ADR-0006) ---
LIVE_TRADING=false
